{
  "info": {
    "name": "Lab05 Registration API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "T1 Happy path: идэвхтэй оюутан, урьдач хангасан → OK",
      "item": [
        {
          "name": "setup оюутан",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"active\",\"coursesTaken\":[\"CS201\"]}"
            },
            "url": {
              "raw": "{{baseUrl}}/students/T1_S",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "T1_S"
              ]
            }
          }
        },
        {
          "name": "setup хичээл",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\":[\"CS201\"]}"
            },
            "url": {
              "raw": "{{baseUrl}}/courses/T1_C",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "T1_C"
              ]
            }
          }
        },
        {
          "name": "T1 Happy path: идэвхтэй оюутан, урьдач хангасан → OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"result = OK\", function () { pm.expect(pm.response.json().result).to.eql(\"OK\"); });",
                  "pm.test(\"registrationID нь тоо\", function () { pm.expect(pm.response.json().registrationID).to.be.a(\"number\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\":\"T1_S\",\"courseID\":\"T1_C\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            }
          }
        }
      ]
    },
